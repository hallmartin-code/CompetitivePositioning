ANTHROPIC_API_KEY=sk-ant-...

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# OUTPUT_DIR=output

# Result emails via Resend. Every generated analysis is emailed with the PDF
# attached. Leave RESEND_API_KEY unset to keep emails off.
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL_TO=Info@tencapital.group
# Must be on a domain verified at https://resend.com/domains.
# NOTIFY_EMAIL_FROM=TEN Capital Competition Analysis <noreply@tencapital.group>
# EMAIL_NOTIFICATIONS=true
